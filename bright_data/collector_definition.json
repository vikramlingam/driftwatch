{
  "collector_id": "c_mszrbi1u1hs5ef50n3",
  "name": "stripe-docs-changelog",
  "description": "Custom Bright Data Scraper Studio collector for extracting API breaking changes, deprecations, and schema changes from Stripe Documentation.",
  "platform": "Bright Data Scraper Studio (Data Collector API)",
  "trigger_endpoint": "https://api.brightdata.com/dca/trigger?collector=c_mszrbi1u1hs5ef50n3&queue_next=1",
  "dataset_endpoint": "https://api.brightdata.com/dca/dataset?id={job_id}",
  "input_schema": {
    "url": {
      "type": "string",
      "default": "https://docs.stripe.com/changelog",
      "description": "Target documentation URL"
    }
  },
  "output_schema": {
    "entry_id": {
      "type": "string",
      "description": "Unique identifier for changelog entry"
    },
    "ecosystem": {
      "type": "string",
      "default": "Stripe"
    },
    "title": {
      "type": "string",
      "description": "Headline or release version"
    },
    "category": {
      "type": "string",
      "enum": ["BREAKING_CHANGE", "DEPRECATION", "TOOL_SCHEMA_CHANGE", "FEATURE_UPDATE"]
    },
    "urgency": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    },
    "plain_summary": {
      "type": "string",
      "description": "Clean English summary of the change"
    },
    "affected_code": {
      "type": "array",
      "items": { "type": "string" },
      "description": "API endpoints, parameter names, or methods impacted"
    },
    "source_url": {
      "type": "string"
    },
    "discovered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "runtime": {
    "engine": "nodejs_cheerio",
    "parser_file": "./collector_parser.js"
  }
}
